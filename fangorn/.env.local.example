GOOGLE_CLIENT_ID=
GOOGLE_USER=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Privy app ID (from https://dashboard.privy.io). Must be VITE_-prefixed to reach the client.
VITE_PRIVY_APP_ID=

# The chain, RPC and registry addresses come from the SDK (BaseSepoliaConfig) — there
# are no address env vars. Bump @fangorn-network/sdk to move to a new deployment.

# Optional: a keyed Base Sepolia RPC, and the most blocks its eth_getLogs takes per
# call. Defaults: the SDK's publicnode RPC, 50000.
VITE_RPC_URL=
VITE_LOG_WINDOW=

# USDC token (Base Sepolia) app subscriptions are paid in. Defaults to Circle's
# testnet USDC; must match AppRegistry.usdc().
VITE_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# pinata-url-provider worker — the dashboard reads GET /usage from it to show how
# much storage the wallet has used. Defaults to the hosted worker if unset.
VITE_WORKER_URL=https://sepolia.storage-worker.fangorn.network

# Feature flag: the account hub (#/account). Anything but `true` shows "Coming soon".
VITE_ENABLE_ACCOUNT=false
