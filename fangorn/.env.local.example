GOOGLE_CLIENT_ID=
GOOGLE_USER=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Privy app ID (from https://dashboard.privy.io). Must be VITE_-prefixed to reach the client.
VITE_PRIVY_APP_ID=

# The DataRegistry, AppRegistry and SubscriptionRegistry addresses all come from the
# SDK (FangornConfig), along with the chain and RPC — there is no VITE_REGISTRY_ADDRESS
# and no VITE_SUBSCRIPTION_ADDRESS. A SubscriptionRegistry is only usable if its
# dataRegistry() matches the registry the SDK publishes to, so pinning it here is how
# the pair drifts. Bump @fangorn-network/sdk to move to a new deployment.

# USDC token (Arbitrum Sepolia) the subscription fee is paid in (registration is
# paid in native ETH). Defaults to Circle's testnet USDC; must match SubscriptionRegistry.usdc().
VITE_USDC_ADDRESS=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d

# fangorn-faucet worker (websites/faucet) — drips 0.05 ETH + 10 USDC per wallet
# per 24h. Defaults to the hosted worker if unset.
VITE_FAUCET_URL=https://sepolia.faucet.fangorn.network

# pinata-url-provider worker — the dashboard reads GET /usage from it to show how
# much storage the wallet has used. Defaults to the hosted worker if unset.
VITE_WORKER_URL=https://sepolia.storage-worker.fangorn.network

# IPFS gateway for reading content-addressed blocks. The publisher directory resolves
# each namespace's NAME through it (the StateCommitted event carries only
# keccak(name)), so an unreachable gateway means the directory shows hashes.
#
# ⚠️ NO trailing `/ipfs` — the SDK appends that itself, and a suffix here produces
# `/ipfs/ipfs/<cid>` and a 400. (quickbeam's own --ipfs-gateway flag DOES want the
# suffix; the two conventions differ.)
#
# The SDK's default is ipfs.io, which does not serve this content reliably and is
# DNS-filtered on many networks — measured 0/40 there vs 40/40 on the gateway below.
VITE_IPFS_GATEWAY=https://green-reasonable-heron-957.mypinata.cloud

# quickbeam-registry worker (webworker/quickbeam-registry) — the Quickbeam panel
# POSTs /views to it to create a view, and the same worker proxies /q/{view}/search so
# a browser can query the instance over HTTPS. Defaults to the hosted worker if unset.
#
# ⚠️ If this points at a *.workers.dev subdomain with no worker on it, the browser
# reports a CORS error ("No 'Access-Control-Allow-Origin' header") rather than a 404,
# because Cloudflare's not-found page carries no CORS headers. Check the URL first.
VITE_QUICKBEAM_WORKER_URL=https://quickbeam-registry.quickbeam.workers.dev